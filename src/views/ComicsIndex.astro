---
import Base from '../layouts/Base.astro';
import StoryGrid from '../components/StoryGrid.astro';
import ComicsTabs from '../components/ComicsTabs.astro';
import Newsletter from '../components/Newsletter.astro';
import { getStories } from '../lib/content';
import { STRINGS, getLang } from '../i18n';

const lang = getLang(Astro.currentLocale);
const t = STRINGS[lang].comics;
const stories = await getStories(lang);
---

<Base title={t.title} description={t.description} image={stories[0]?.data.cover} newsletter={false}>
  <section class="wrap section">
    <h1>{t.title}</h1>
    <ComicsTabs />
    <StoryGrid stories={stories} featureFirst />
  </section>
  <section class="wrap signup">
    <Newsletter centered />
  </section>
</Base>
