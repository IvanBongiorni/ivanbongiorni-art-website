---
import { SOCIALS } from '../site.config';
import { STRINGS, getLang } from '../i18n';

const links = SOCIALS.filter((s) => s.url);
---

{
  links.length > 0 && (
    <ul class="socials" aria-label={STRINGS[getLang(Astro.currentLocale)].footer.elsewhere}>
      {links.map((l) => (
        <li>
          <a href={l.url} rel="me noopener" target="_blank">
            {l.name}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
</style>
