---
import Newsletter from './Newsletter.astro';
import SocialLinks from './SocialLinks.astro';
import { SITE } from '../site.config';
import { STRINGS, getLang } from '../i18n';

interface Props {
  // Hide the signup form on pages that already show one in the content.
  newsletter?: boolean;
}

const { newsletter = true } = Astro.props;
const year = new Date().getFullYear();
const t = STRINGS[getLang(Astro.currentLocale)].footer;
---

<footer class="site-footer">
  <div class="wrap grid">
    {newsletter && <Newsletter />}
    <div class="side">
      <SocialLinks />
      <p class="meta">
        © {year} {SITE.author}. {t.rights}<br />
        {t.reproduction}
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 2rem;
    padding: 2.5rem 0;
  }
  .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
  }
  .side {
    display: grid;
    gap: 1rem;
  }
  .side p {
    margin: 0;
  }
</style>
