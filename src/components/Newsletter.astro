---
import { NEWSLETTER } from '../site.config';

interface Props {
  heading?: string;
  pitch?: string;
  // Centered when it stands on its own at the end of a page; left-aligned in the footer.
  centered?: boolean;
}

const { heading = 'Get notified of new stories', pitch = NEWSLETTER.pitch, centered = false } = Astro.props;
const action = `https://app.kit.com/forms/${NEWSLETTER.kitFormId}/subscriptions`;
---

{
  NEWSLETTER.kitFormId && (
    <form class:list={['newsletter', { centered }]} id="newsletter" action={action} method="post">
      <p class="heading">{heading}</p>
      <p class="muted">{pitch}</p>
      <div class="row">
        <input type="email" name="email_address" aria-label="Email address" placeholder="you@example.com" required autocomplete="email" />
        <button class="button" type="submit">Subscribe</button>
      </div>
    </form>
  )
}

<style>
  .newsletter {
    max-width: 30rem;
  }
  .centered {
    margin-inline: auto;
    text-align: center;
  }
  .centered .row {
    justify-content: center;
  }
  .heading {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: 0.25em;
  }
  .row {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  input {
    flex: 1 1 14rem;
    min-width: 0;
    padding: 0.7em 0.9em;
    font: inherit;
    border: 1px solid var(--ink);
    border-radius: 2px;
    background: #fff;
  }
</style>
