---
// Mosaic of story covers, laid out like the art gallery: covers keep their own
// shape and stack into columns, so tall, square and wide covers interlock.
import StoryCard from './StoryCard.astro';
import type { Story } from '../lib/content';

interface Props {
  stories: Story[];
}

const { stories } = Astro.props;
---

<div class="mosaic">
  {stories.map((story) => <StoryCard story={story} />)}
</div>

<style>
  .mosaic {
    columns: 3 260px;
    column-gap: clamp(1rem, 2.5vw, 2rem);
  }
  .mosaic > :global(*) {
    break-inside: avoid;
    margin-bottom: clamp(1.25rem, 3vw, 2.25rem);
  }
  @media (max-width: 480px) {
    .mosaic {
      columns: 2;
    }
  }
</style>
