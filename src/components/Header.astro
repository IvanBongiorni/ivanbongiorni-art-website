---
import { NEWSLETTER, SITE } from '../site.config';

const links = [
  { href: '/', label: 'Comics' },
  { href: '/art/', label: 'Art' },
  { href: '/about/', label: 'About' },
];

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/comics') : path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="name" href="/">{SITE.title}</a>
    <nav aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      {NEWSLETTER.kitFormId && <a class="subscribe" href="#newsletter">Subscribe</a>}
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }
  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .name {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  nav {
    display: flex;
    gap: clamp(1rem, 3vw, 2rem);
  }
  nav a {
    text-decoration: none;
    color: var(--muted);
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
  }
  nav a.subscribe {
    color: var(--accent);
  }
  /* No room for a fourth link next to the name on phones; the form is at the end of the page. */
  @media (max-width: 30rem) {
    nav a.subscribe {
      display: none;
    }
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
</style>
