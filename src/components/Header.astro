---
import { NEWSLETTER, SITE } from '../site.config';
import { LANGS, STRINGS, getLang, localize, unlocalize, type Lang } from '../i18n';

interface Props {
  // This page in each language, for the language switch.
  translations: Partial<Record<Lang, string>>;
}

const lang = getLang(Astro.currentLocale);
const t = STRINGS[lang];

const links = [
  { href: '/', label: t.nav.comics },
  { href: '/art/', label: t.nav.art },
  { href: '/about/', label: t.nav.about },
];

const path = unlocalize(Astro.url.pathname);
const isCurrent = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/comics') : path.startsWith(href);

// Link to this page in the other language, or to its home page if this page isn't translated.
const other = LANGS.find((l) => l !== lang)!;
const switchHref = Astro.props.translations[other] ?? localize('/', other);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="name" href={localize('/', lang)}>{SITE.title}</a>
    <nav aria-label={t.nav.label}>
      {links.map((l) => (
        <a href={localize(l.href, lang)} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      {NEWSLETTER.kitFormId && <a class="subscribe" href="#newsletter">{t.nav.updateMe}</a>}
    </nav>
    <div class="tools">
      <button class="theme" type="button" aria-pressed="false" title={t.darkMode}>
        <svg class="moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z" />
        </svg>
        <svg class="sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" />
        </svg>
        <span class="visually-hidden">{t.darkMode}</span>
      </button>
      <a class="lang" href={switchHref} hreflang={other} lang={other} title={STRINGS[other].switchTo}>
        {
          other === 'it' ? (
            <svg class="flag" viewBox="0 0 3 2" width="18" height="12" aria-hidden="true">
              <path fill="#009246" d="M0 0h1v2H0z" />
              <path fill="#fff" d="M1 0h1v2H1z" />
              <path fill="#ce2b37" d="M2 0h1v2H2z" />
            </svg>
          ) : (
            <svg class="flag" viewBox="0 0 60 30" width="22" height="12" aria-hidden="true">
              <clipPath id="flag-uk-diagonals">
                <path d="M30 15h30v15zv15H0zH0V0zV0h30z" />
              </clipPath>
              <path fill="#012169" d="M0 0h60v30H0z" />
              <path stroke="#fff" stroke-width="6" d="M0 0l60 30m0-30L0 30" />
              <path stroke="#c8102e" stroke-width="4" d="M0 0l60 30m0-30L0 30" clip-path="url(#flag-uk-diagonals)" />
              <path stroke="#fff" stroke-width="10" d="M30 0v30M0 15h60" />
              <path stroke="#c8102e" stroke-width="6" d="M30 0v30M0 15h60" />
            </svg>
          )
        }
        <span aria-hidden="true">{other.toUpperCase()}</span>
        <span class="visually-hidden">{STRINGS[other].switchTo}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }
  .bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 3vw, 2rem);
  }
  .name {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    margin-right: auto;
  }
  nav {
    display: flex;
    gap: clamp(0.75rem, 3vw, 2rem);
  }
  nav a,
  .lang,
  .theme {
    text-decoration: none;
    color: var(--muted);
    white-space: nowrap;
  }
  nav a:hover,
  nav a[aria-current='page'],
  .lang:hover,
  .theme:hover {
    color: var(--ink);
  }
  nav a.subscribe {
    color: var(--accent);
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    padding-left: clamp(0.75rem, 3vw, 2rem);
    border-left: 1px solid var(--line);
  }
  .lang {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  /* Moon in light mode (switch to dark), sun in dark mode (switch back). */
  .theme {
    display: flex;
    padding: 0.25rem;
    margin: -0.25rem;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .theme svg {
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 0;
  }
  .sun path {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
  }
  .sun,
  :global([data-theme='dark']) .moon {
    display: none;
  }
  :global([data-theme='dark']) .sun {
    display: block;
  }
  /* Thin edge so the white stripe doesn't disappear into the paper colour. */
  .flag {
    border-radius: 1px;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.12);
  }
  /* On phones: name and switches on top, the menu on a second row.
     No room for a fourth link there; the form is at the end of the page. */
  @media (max-width: 32rem) {
    .bar {
      height: auto;
      flex-wrap: wrap;
      row-gap: 0.25rem;
      padding-block: 0.75rem;
    }
    nav {
      order: 1;
      width: 100%;
    }
    nav a.subscribe {
      display: none;
    }
    .tools {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('.site-header .theme')!;
  const root = document.documentElement;
  const sync = () => button.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  sync();
  button.addEventListener('click', () => {
    const dark = root.dataset.theme !== 'dark';
    if (dark) root.dataset.theme = 'dark';
    else delete root.dataset.theme;
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {}
    sync();
  });
</script>
