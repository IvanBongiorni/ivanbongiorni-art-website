---
// Masonry grid of images. Clicking one opens it full screen (PhotoSwipe).
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface GalleryItem {
  id: string;
  image: ImageMetadata;
  // Alt text and the label under the thumbnail.
  title: string;
  // Optional second line under the thumbnail.
  detail?: string;
  // Shown in the full-screen view.
  caption: string;
}

interface Props {
  items: GalleryItem[];
}

const items = await Promise.all(
  Astro.props.items.map(async (item) => {
    const { image } = item;
    const width = Math.min(image.width, 2000);
    const height = Math.round((image.height * width) / image.width);
    const full = await getImage({ src: image, width, format: 'webp' });
    return { item, full: full.src, width, height };
  }),
);
---

<div class="gallery" data-gallery>
  {
    items.map(({ item, full, width, height }) => (
      <a
        class="item"
        href={full}
        data-pswp-width={width}
        data-pswp-height={height}
        data-caption={item.caption}
        id={item.id}
      >
        <Image
          src={item.image}
          alt={item.title}
          widths={[360, 540, 720]}
          sizes="(min-width: 1000px) 360px, (min-width: 600px) 45vw, 100vw"
        />
        <span class="caption">{item.title}</span>
        {item.detail && <span class="caption detail">{item.detail}</span>}
      </a>
    ))
  }
</div>

<style>
  .gallery {
    columns: 3 300px;
    column-gap: clamp(1rem, 2.5vw, 2rem);
  }
  .item {
    display: block;
    break-inside: avoid;
    margin-bottom: clamp(1rem, 2.5vw, 2rem);
    text-decoration: none;
  }
  .item :global(img) {
    width: 100%;
  }
  .caption {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .detail {
    margin-top: 0;
    font-size: 0.8rem;
  }
</style>

<script>
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import 'photoswipe/style.css';

  const lightbox = new PhotoSwipeLightbox({
    gallery: '[data-gallery]',
    children: 'a',
    pswpModule: () => import('photoswipe'),
    bgOpacity: 0.95,
  });

  lightbox.on('uiRegister', () => {
    lightbox.pswp?.ui?.registerElement({
      name: 'caption',
      order: 9,
      isButton: false,
      appendTo: 'root',
      onInit: (el, pswp) => {
        pswp.on('change', () => {
          el.textContent = pswp.currSlide?.data.element?.dataset.caption ?? '';
        });
      },
    });
  });

  lightbox.init();
</script>

<style is:global>
  .pswp__caption {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    max-width: calc(100% - 2rem);
    padding: 0.4rem 0.8rem;
    color: #eee;
    font-size: 0.9rem;
    text-align: center;
    background: rgb(0 0 0 / 0.5);
    border-radius: 3px;
  }
  .pswp__caption:empty {
    display: none;
  }
</style>
