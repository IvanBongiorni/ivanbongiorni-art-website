---
import { Image } from 'astro:assets';
import { getPages, formatDate, storyId, storyLang, type Story } from '../lib/content';
import { STRINGS, localize } from '../i18n';

interface Props {
  story: Story;
  // The latest story: double-width tile with larger text.
  featured?: boolean;
}

const { story, featured = false } = Astro.props;
const lang = storyLang(story);
const t = STRINGS[lang].comics;
const pageCount = getPages(storyId(story), lang).length;
---

<a class:list={['card', { featured }]} href={localize(`/comics/${storyId(story)}/`, lang)}>
  <Image
    src={story.data.cover}
    alt={t.cover(story.data.title)}
    widths={featured ? [640, 960, 1280] : [320, 480, 720]}
    sizes={featured
      ? '(min-width: 1000px) 460px, (min-width: 700px) 40vw, 100vw'
      : '(min-width: 1000px) 380px, (min-width: 600px) 33vw, 50vw'}
    loading={featured ? 'eager' : 'lazy'}
  />
  <div class="text">
    {featured && <p class="label">{t.latest}</p>}
    <h3>{story.data.title}</h3>
    <p class="meta">
      <time datetime={story.data.date.toISOString().slice(0, 10)}>{formatDate(story.data.date, lang)}</time>
      {' · '}{t.pages(pageCount)}
    </p>
    <p class="description">{story.data.description}</p>
  </div>
</a>

<style>
  .card {
    display: block;
    text-decoration: none;
  }
  .card :global(img) {
    width: 100%;
    border: 1px solid var(--line);
    transition: transform 0.2s ease;
  }
  .card:hover :global(img) {
    transform: translateY(-3px);
  }
  .text {
    padding-top: 0.75rem;
  }
  h3 {
    font-size: 1.15rem;
    margin: 0 0 0.15rem;
  }
  p {
    margin: 0;
  }

  @media (min-width: 700px) {
    .featured {
      display: grid;
      grid-template-columns: 3fr 2fr;
      gap: clamp(1rem, 2.5vw, 2rem);
      align-items: end;
    }
    .featured .text {
      padding: 0 0 0.5rem;
    }
  }
  .featured :global(img) {
    box-shadow: 0 14px 40px -20px rgb(0 0 0 / 0.45);
  }
  .featured h3 {
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
  }
  .label {
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }
  .description {
    font-family: var(--serif);
    font-size: 0.98rem;
    line-height: 1.45;
    margin-top: 0.35rem;
  }
  .featured .description {
    font-size: 1.15rem;
    max-width: 34rem;
  }
</style>
