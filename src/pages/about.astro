---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE } from '../site.config';
---

<Base
  title="About"
  description={`About ${SITE.author}: comics, illustration, painting and photography.`}
  newsletter={false}
>
  <section class="wrap narrow section">
    <h1>About</h1>

    <!-- TODO: replace with your bio. -->
    <p>
      I'm Ivan Bongiorni. I write and draw short comic stories, inked by hand on A3 paper. I also paint,
      illustrate and take photographs.
    </p>

    <h2>Contact</h2>
    {SITE.email && <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>}
    <SocialLinks />

    <div class="newsletter">
      <Newsletter />
    </div>
  </section>
</Base>

<style>
  h2 {
    margin-top: 2.5rem;
  }
  .newsletter {
    margin-top: 3rem;
  }
</style>
