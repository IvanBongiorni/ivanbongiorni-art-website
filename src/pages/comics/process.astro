---
// Work in progress: unfinished pages and sketches, grouped by story,
// most recently worked-on story first. Every image carries its date.
import Base from '../../layouts/Base.astro';
import ComicsTabs from '../../components/ComicsTabs.astro';
import Gallery, { type GalleryItem } from '../../components/Gallery.astro';
import Newsletter from '../../components/Newsletter.astro';
import { getProcess, getStories, formatDate } from '../../lib/content';

const [process, stories] = await Promise.all([getProcess(), getStories()]);

// Items arrive newest first, so groups come out in order of latest activity.
const groups = new Map<string, { anchor: string; heading: string; href?: string; items: GalleryItem[] }>();
for (const item of process) {
  const key = item.data.story ?? '';
  const story = stories.find((s) => s.id === key);
  if (!groups.has(key)) {
    groups.set(key, {
      anchor: key ? key.toLowerCase().replace(/[^a-z0-9]+/g, '-') : 'sketches',
      heading: story?.data.title ?? (key || 'Sketches'),
      href: story && `/comics/${story.id}/`,
      items: [],
    });
  }
  const date = formatDate(item.data.date);
  groups.get(key)!.items.push({
    id: item.id.replaceAll('/', '-'),
    image: item.data.image,
    title: item.data.title,
    detail: [item.data.stage, date].filter(Boolean).join(' · '),
    caption: [item.data.title, item.data.stage, date].filter(Boolean).join(' · '),
  });
}
---

<Base
  title="Work in progress"
  description="Unfinished pages, sketches and pencils from Ivan Bongiorni's comics."
  image={process[0]?.data.image}
  newsletter={false}
>
  <section class="wrap section">
    <h1 class="visually-hidden">Work in progress</h1>
    <ComicsTabs />
    <p class="intro">
      Pages before they are finished: thumbnails, pencils, inks. Each one is dated the day it was drawn.
    </p>
    {
      groups.size > 0 ? (
        [...groups.values()].map((group) => (
          <section class="group" id={group.anchor}>
            <h2>{group.href ? <a href={group.href}>{group.heading}</a> : group.heading}</h2>
            <Gallery items={group.items} />
          </section>
        ))
      ) : (
        <p class="muted">Nothing here yet.</p>
      )
    }
  </section>
  <section class="wrap signup">
    <Newsletter centered heading="Follow along" pitch="Get an email when the stories you see taking shape here are finished." />
  </section>
</Base>

<style>
  .intro {
    max-width: 36rem;
    margin-bottom: 2.5rem;
    font-family: var(--serif);
    font-size: 1.15rem;
  }
  .group + .group {
    margin-top: clamp(2rem, 5vw, 3.5rem);
  }
  h2 a {
    text-decoration: none;
  }
  h2 a:hover {
    text-decoration: underline;
  }
</style>
