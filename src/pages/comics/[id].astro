---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Reader from '../../components/Reader.astro';
import Newsletter from '../../components/Newsletter.astro';
import StoryGrid from '../../components/StoryGrid.astro';
import { getStories, getPages, formatDate, type Story } from '../../lib/content';

export async function getStaticPaths() {
  const stories = await getStories();
  return stories.map((story) => ({ params: { id: story.id }, props: { story, stories } }));
}

interface Props {
  story: Story;
  stories: Story[];
}

const { story, stories } = Astro.props;
const pages = getPages(story.id);
const { Content } = await render(story);
const hasNote = Boolean(story.body?.trim());
const more = stories.filter((s) => s.id !== story.id).slice(0, 4);
---

<Base title={story.data.title} description={story.data.blurb} image={story.data.cover}>
  <header class="wrap story-head">
    <h1>{story.data.title}</h1>
    <p class="meta">{formatDate(story.data.date)} · {pages.length} {pages.length === 1 ? 'page' : 'pages'}</p>
    <p class="blurb">{story.data.blurb}</p>
  </header>

  <div class="reader-wrap">
    <Reader title={story.data.title} pages={pages} />
  </div>

  <section class="wrap narrow section end">
    <p class="the-end">End</p>
    {
      hasNote && (
        <div class="note">
          <Content />
        </div>
      )
    }
    <Newsletter heading="Want to read the next one?" />
  </section>

  {
    more.length > 0 && (
      <section class="wrap section">
        <h2>More stories</h2>
        <StoryGrid stories={more} />
      </section>
    )
  }
</Base>

<style>
  .story-head {
    padding-top: clamp(1.5rem, 4vw, 3rem);
    padding-bottom: 1.5rem;
    text-align: center;
  }
  .blurb {
    font-family: var(--serif);
    font-size: 1.2rem;
    max-width: 36rem;
    margin: 0 auto;
  }
  .reader-wrap {
    max-width: 1000px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .reader-wrap {
      padding: 0 var(--gutter);
    }
  }
  .the-end {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.5rem;
    text-align: center;
    margin-bottom: 2rem;
  }
  .end {
    display: grid;
    gap: 2rem;
    justify-items: center;
  }
  .note {
    width: 100%;
  }
</style>
