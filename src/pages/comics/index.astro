---
import Base from '../../layouts/Base.astro';
import StoryGrid from '../../components/StoryGrid.astro';
import ComicsTabs from '../../components/ComicsTabs.astro';
import { getStories } from '../../lib/content';

const stories = await getStories();
---

<Base title="Comics" description="All comic stories by Ivan Bongiorni." image={stories[0]?.data.cover}>
  <section class="wrap section">
    <h1>Comics</h1>
    <ComicsTabs />
    <StoryGrid stories={stories} featureFirst />
  </section>
</Base>
